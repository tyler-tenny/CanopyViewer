@page "{id:int}"
@model CanopyViewer.Pages.WorkOrders.EditModel
@{
    ViewData["Title"] = "Edit Work Order";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Edit Work Order</h2>
    <a asp-page="Details" asp-route-id="@Model.Input.Id"
       class="btn btn-secondary">← Back</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="post">
            <input type="hidden" asp-for="Input.Id" />
            <input type="hidden" asp-for="Input.CreatedBy" />
            <input type="hidden" asp-for="Input.CreatedDate" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label class="form-label">Title <span class="text-danger">*</span></label>
                <input asp-for="Input.Title" class="form-control" />
                <span asp-validation-for="Input.Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Status</label>
                <select asp-for="Input.Status" class="form-select">
                    <option>New</option>
                    <option>In Progress</option>
                    <option>On Hold</option>
                    <option>Completed</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Action Taken</label>
                <textarea asp-for="Input.ActionTaken" class="form-control" rows="3"></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Assigned By</label>
                    <select asp-for="Input.AssignedById" class="form-select select2"
                            id="assignedBySelect">
                        <option value="">— None —</option>
                        @foreach (var user in Model.Users)
                        {
                            <option value="@user.Id">@user.Username (@user.Role)</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Assigned To</label>
                    <select asp-for="Input.AssignedToId" class="form-select select2"
                            id="assignedToSelect">
                        <option value="">— Unassigned —</option>
                        @foreach (var user in Model.Users)
                        {
                            <option value="@user.Id">@user.Username (@user.Role)</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Linked Asset</label>
                <select asp-for="Input.AssetId" class="form-select select2"
                        id="assetSelect">
                    <option value="">— None —</option>
                    @foreach (var asset in Model.Assets)
                    {
                        <option value="@asset.Id">@asset.Name</option>
                    }
                </select>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-page="Details" asp-route-id="@Model.Input.Id"
                   class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $('#assignedBySelect').select2({ theme: 'bootstrap-5', placeholder: 'Search users...', allowClear: true });
        $('#assignedToSelect').select2({ theme: 'bootstrap-5', placeholder: 'Search users...', allowClear: true });
        $('#assetSelect').select2({ theme: 'bootstrap-5', placeholder: 'Search assets...', allowClear: true });
    </script>
}
