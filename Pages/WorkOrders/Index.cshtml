@page
@model CanopyViewer.Pages.WorkOrders.IndexModel
@{
    ViewData["Title"] = "Work Orders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Work Orders</h2>

    <a class="btn btn-primary" asp-page="Create">New Work Order</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <input class="form-control" name="Search"
                       placeholder="Search work orders..." />
            </div>

            <div class="col-md-3">
                <select class="form-select" name="Status">
                    <option value="">Any Status</option>
                    <option>Open</option>
                    <option>Closed</option>
                </select>
            </div>

            <div class="col-md-2">
                <button class="btn btn-secondary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>
                        <a href="#">Name</a>
                    </th>
                    <th>
                        <a href="#">Type</a>
                    </th>
                    <th>
                        <a href="#">Completion Date</a>
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>Example Work Order</td>
                    <td>HVAC</td>
                    <td>4/23/26</td>
                    <td>
                        <a asp-page="Edit" asp-route-id="1">Edit</a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<nav class="mt-3">
    <ul class="pagination">
        <li class="page-item disabled">
            <a class="page-link">Previous</a>
        </li>
        <li class="page-item active">
            <a class="page-link">1</a>
        </li>
        <li class="page-item active">
            <a class="page-link">Next</a>
        </li>
    </ul>
</nav>

