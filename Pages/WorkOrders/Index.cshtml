@page
@model CanopyViewer.Pages.WorkOrders.IndexModel
@{
    ViewData["Title"] = "Work Orders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Work Orders</h2>
    <a class="btn btn-primary" asp-page="Create">New Work Order</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <input class="form-control" name="Search"
                       value="@Model.Search"
                       placeholder="Search by title, description, assignee..." />
            </div>

            <div class="col-md-3">
                <select class="form-select" name="StatusFilter">
                    <option value="">Any Status</option>
                    <option selected="@(Model.StatusFilter == "New")">New</option>
                    <option selected="@(Model.StatusFilter == "In Progress")">In Progress</option>
                    <option selected="@(Model.StatusFilter == "On Hold")">On Hold</option>
                    <option selected="@(Model.StatusFilter == "Completed")">Completed</option>
                </select>
            </div>
            <input type="hidden" name="sort" value="@Model.Sort" />
            <input type="hidden" name="dir" value="@Model.Dir" />
            <div class="col-md-2">
                <button class="btn btn-secondary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>
                        <a href="@Model.SortLink("Id")" class="text-decoration-none text-dark">
                            Id<i class="@Model.SortIcon("Id")"></i>
                        </a>
                    </th>
                    <th>
                        <a href="@Model.SortLink("Title")" class="text-decoration-none text-dark">
                            Title<i class="@Model.SortIcon("Title")"></i>
                        </a>
                    </th>
                    <th>
                        <a href="@Model.SortLink("Status")" class="text-decoration-none text-dark">
                            Status<i class="@Model.SortIcon("Status")"></i>
                        </a>
                    </th>
                    <th>
                        <a href="@Model.SortLink("AssignedTo")" class="text-decoration-none text-dark">
                            Assigned To<i class="@Model.SortIcon("AssignedTo")"></i>
                        </a>
                    </th>
                    <th>Linked Asset</th>
                    <th>
                        <a href="@Model.SortLink("CreatedDate")" class="text-decoration-none text-dark">
                            Created Date<i class="@Model.SortIcon("CreatedDate")"></i>
                        </a>
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.WorkOrders.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No work orders found.
                        </td>
                    </tr>
                }
                @foreach (var wo in Model.WorkOrders)
                {
                    <tr style="cursor:pointer"
                        onclick="window.location='/WorkOrders/Details/@wo.Id'">
                        <td>@wo.Id</td>
                        <td>@wo.Title</td>
                        <td>
                            <span class="badge @(wo.Status switch {
                              "New" => "bg-primary",
                              "In Progress" => "bg-warning text-dark",
                              "On Hold" => "bg-secondary",
                              "Completed" => "bg-success",
                              _ => "bg-light text-dark"
                            })">@wo.Status</span>
                    </td>
                    <td>@(wo.AssignedTo?.Username ?? "Unassigned")</td>
                    <td>
                        @if (wo.Asset != null)
                            {
                                <a asp-page="/Assets/Details" asp-route-id="@wo.AssetId"
                                    onclick="event.stopPropagation()">
                                    @wo.Asset.Name
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>

                        <td>@wo.CreatedDate.ToString("MM/dd/yyyy")</td>
                        <td>
                            <a asp-page="Edit" asp-route-id="@wo.Id"
                                onclick="event.stopPropagation()"
                                class="btn btn-sm btn-outline-secondary">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

