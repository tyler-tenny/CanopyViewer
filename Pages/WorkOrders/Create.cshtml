@page
@model CanopyViewer.Pages.WorkOrders.CreateModel
@{
    ViewData["Title"] = "New Work Order";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>New Work Order</h2>
    <a asp-page="Index" class="btn btn-secondary">← Back</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label class="form-label">Title <span class="text-danger">*</span></label>
                <input asp-for="Input.Title" class="form-control" />
                <span asp-validation-for="Input.Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Status</label>
                <input asp-for="Input.Status" class="form-control" readonly disabled />
                <input type="hidden" asp-for="Input.Status" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Created By</label>
                    <input asp-for="Input.CreatedBy" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Created Date</label>
                    <input asp-for="Input.CreatedDate" type="datetime-local"
                           class="form-control" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Assigned By</label>
                    <select asp-for="Input.AssignedById" class="form-select select2"
                            id="assignedBySelect">
                        <option value="">— None —</option>
                        @foreach (var user in Model.Users)
                        {
                            <option value="@user.Id">@user.Username (@user.Role)</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Assigned To</label>
                    <select asp-for="Input.AssignedToId" class="form-select select2"
                            id="assignedToSelect">
                        <option value="">— Unassigned —</option>
                        @foreach (var user in Model.Users)
                        {
                            <option value="@user.Id">@user.Username (@user.Role)</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Linked Asset <span class="text-muted small">(optional)</span></label>
                <select asp-for="Input.AssetId" class="form-select">
                    <option value="">— None —</option>
                    @foreach (var asset in Model.Assets)
                    {
                        <option value="@asset.Id">@asset.Name</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Recurrence</label>
                <select asp-for="Input.RecurrenceType" class="form-select"
                        id="recurrenceType">
                    <option>One-Time</option>
                    <option>Recurring</option>
                </select>
            </div>

            <div id="recurringFields" style="display:none">
                <div class="card bg-light mb-3">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Interval</label>
                                <select asp-for="Input.RecurrenceInterval" class="form-select">
                                    <option>Daily</option>
                                    <option>Weekly</option>
                                    <option>Monthly</option>
                                    <option>Yearly</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Start Date</label>
                                <input asp-for="Input.StartDate" type="date"
                                       class="form-control" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">
                                    Recur Count
                                    <span class="text-muted small">(blank = indefinite)</span>
                                </label>
                                <input asp-for="Input.RecurCount" type="number"
                                       class="form-control" min="1" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create Work Order</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $('#assignedBySelect').select2({
            theme: 'bootstrap-5',
            placeholder: 'Search users...',
            allowClear: true
        });
        $('#assignedToSelect').select2({
            theme: 'bootstrap-5',
            placeholder: 'Search or select a user...',
            allowClear: true
        });

        const recurrenceSelect = document.getElementById('recurrenceType');
        const recurringFields = document.getElementById('recurringFields');

        function toggleRecurring() {
            recurringFields.style.display =
                recurrenceSelect.value === 'Recurring' ? 'block' : 'none';
        }

        toggleRecurring();
        recurrenceSelect.addEventListener('change', toggleRecurring);
    </script>
}