<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CanopyViewer</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CanopyViewer.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
</head>
<body>
    <div class="d-flex" id="wrapper">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="border-end bg-light" id="sidebar-wrapper">
                <div class="sidebar-heading px-3 py-2">CanopyViewer</div>
                <div class="list-group list-group-flush">
                    <a asp-page="/Index" class="list-group-item list-group-item-action">Dashboard</a>
                    <a asp-page="/Assets/Index" class="list-group-item list-group-item-action">Assets</a>
                    <a asp-page="/WorkOrders/Index" class="list-group-item list-group-item-action">Work Orders</a>
                    @if (User.IsInRole(CanopyViewer.Models.Role.Admin))
                    {
                        <a asp-page="/Admin/Users/Index" class="list-group-item list-group-item-action">User Management</a>
                    }
                <form method="post" asp-page="/Logout" class="list-group-item list-group-item-action">
                    <button type="submit" class="nav-link btn btn-link text-dark p-0">Logout</button>    
                </form>
            </div>
        </div>
        }

        <div id="page-content-wrapper" class="flex-grow-1">
            <nav class="navbar navbar-light bg-light border-bottom">
                <div class="container-fluid">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <button class="btn btn-primary" id="sidebarToggle">☰</button>
                    }
                    <span class="navbar-brand mb-0 h1">CanopyViewer</span>
                </div>
            </nav>
            <div class="container-fluid mt-3">
                @RenderBody()
            </div>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CanopyViewer - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        var sidebarToggle = document.getElementById("sidebarToggle");
        var wrapper = document.getElementById("wrapper");

        sidebarToggle.addEventListener("click", function () {
            wrapper.classList.toggle("toggled");
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
</body>
</html>