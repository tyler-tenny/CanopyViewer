@page
@model CanopyViewer.Pages.Assets.IndexModel
@{
    ViewData["Title"] = "Assets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Assets</h2>
    <a class="btn btn-primary" asp-page="Create">New Asset</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-5">
                <input class="form-control" name="Search"
                    value="@Model.Search"
                    placeholder="Search by name or type..." />
            </div>

            <div class="col-md-2">
                <input type="hidden" name="sort" value="@Model.Sort" />
                <input type="hidden" name="dir" value="@Model.Dir" />
                <button class="btn btn-secondary w-100">Search</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>
                        <a href="@Model.SortLink("Id")" class="text-decoration-none text-dark">
                            ID <i class="@Model.SortIcon("Id")"></i>
                        </a>
                    </th>
                    <th>
                        <a href="@Model.SortLink("Name")" class="text-decoration-none text-dark">
                            Name <i class="@Model.SortIcon("Name")"></i>
                        </a>
                    </th>
                    <th>
                        <a href="@Model.SortLink("Type")" class="text-decoration-none text-dark">
                            Type <i class="@Model.SortIcon("Type")"></i>
                        </a>
                    </th>
                    <th>
                        <a href="@Model.SortLink("Status")" class="text-decoration-none text-dark">
                            Status <i class="@Model.SortIcon("Status")"></i>
                        </a>
                    </th>
                    <th>Actions</th>
                </tr> 
            </thead>
            <tbody>
                @if (!Model.Assets.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            No assets found.
                        </td>
                    </tr>
                }
                @foreach (var asset in Model.Assets)
                {
                    <tr style="cursor:pointer"
                        onclick="window.location='/Assets/Details/@asset.Id'">
                        <td>@asset.Id</td>
                        <td>@asset.Name</td>
                        <td>@asset.Type</td>
                        <td>
                            <span class="badge @(asset.Status == "Active"
                                ? "bg-success" : "bg-secondary")">
                                @asset.Status
                            </span>
                        </td>
                        <td>
                            <a asp-page="Edit" asp-route-id="@asset.Id"
                               onclick="event.stopPropagation()"
                               class="btn btn-sm btn-outline-secondary">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>