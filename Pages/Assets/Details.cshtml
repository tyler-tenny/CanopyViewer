@page
@model CanopyViewer.Pages.Assets.DetailsModel
@{
    ViewData["Title"] = Model.Asset.Name;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Model.Asset.Name</h2>
    <div>
        <a asp-page="Edit" asp-route-id="@Model.Asset.Id"
            class="btn btn-outline-secondary">Edit</a>
        <a asp-page="Index" class="btn btn-secondary ms-2">Back</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Asset Details</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Asset.Id</dd>

            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@(Model.Asset.Type ?? "-")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Asset.Status == "Active"
                    ? "bg-success" : "bg-secondary")">
                    @Model.Asset.Status
                </span>
            </dd>

            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@(Model.Asset.Location ?? "—")</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(Model.Asset.Description ?? "—")</dd>
        </dl>
    </div>
    <div class="text-muted small mt-3 d-flex justify-content-between px-2">
        <span>  Created by: @Model.Asset.CreatedBy</span>
        <span>  Created: @Model.Asset.CreatedDate.ToString("MM/dd/yyyy")</span>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Linked Work Orders</span>
        <a asp-page="/WorkOrders/Create"
           asp-route-assetId="@Model.Asset.Id"
           class="btn btn-sm btn-primary">+ New Work Order</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Asset.WorkOrders.Any())
        {
            <p class="text-muted p-3 mb-0">No work orders linked to this asset.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Assigned To</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var wo in Model.Asset.WorkOrders
                       .OrderByDescending(w => w.CreatedDate))
                        {
                            <tr style="cursor:pointer"
                                onclick="window.location='/WorkOrders/Details?id=@wo.Id'">
                                <td>@wo.Id</td>
                                <td>@wo.Title</td>
                                <td>
                                    <span class="badge @(wo.Status switch {
                                        "New"         => "bg-primary",
                                        "In Progress" => "bg-warning text-dark",
                                        "On Hold"     => "bg-secondary",
                                        "Completed"   => "bg-success",
                                        _             => "bg-light text-dark"
                                    })">@wo.Status</span>
                                </td>
                                <td>@(wo.AssignedTo ?? "Unassigned")</td>
                                <td>@wo.CreatedDate.ToString("MM/dd/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>