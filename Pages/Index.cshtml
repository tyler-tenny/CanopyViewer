@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <h1>CanopyViewer System Prototype</h1>
    <p>Server running in local development environment</p>
    <p>User: @User.Identity?.Name</p>
    <p>Is Authenticated: @User.Identity?.IsAuthenticated</p>
    <p>Is Admin: @User.IsInRole(CanopyViewer.Models.Role.Admin)</p>
    <p>User ID: @int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);</p>
</div>
